# --- Database (shared by apps/web and apps/server) ---
DATABASE_URL="postgresql://user:password@localhost:5432/concord"

# --- Auth (shared secrets) ---
NEXTAUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
API_TOKEN_SECRET=replace-with-a-third-long-random-string

# --- Server (apps/server) ---
PORT=4000
WEB_ORIGIN=http://localhost:3000
SHARE_LINK_SECRET=replace-with-a-different-long-random-string
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=onboarding@resend.dev

# --- Web (apps/web) ---
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
